import java.util.Scanner;
public class Invoice {
    private String invoiceID;
    private double discount;
    private double totalInvoice;

    public Invoice() {
        this.invoiceID = "1";
        this.discount = 2.5;
        this.totalInvoice = 100.0;
    }

    public Invoice(String invoiceID, double discount, double totalInvoice) {
        this.invoiceID = invoiceID;
        this.discount = discount;
        this.totalInvoice = totalInvoice;
    }

    public String getInvoiceID() {
        return invoiceID;
    }

    public double getDiscount() {
        return discount;
    }

    public double getTotalInvoice() {
        return totalInvoice;
    }

    public void setDiscount(double discount) {
        this.discount = discount;
    }

    public void setTotalInvoice(double totalInvoice) {
        this.totalInvoice = totalInvoice;
    }

    public double calculateDiscountPrice() {
        return totalInvoice - (totalInvoice * discount / 100);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Invoice invoice = new Invoice();
        
         System.out.println("Old price: " + invoice.getTotalInvoice());
        System.out.println("New price: " + invoice.calculateDiscountPrice());

        System.out.print("Enter new discount: ");
        invoice.setDiscount(scanner.nextDouble());

        System.out.print("Enter new total invoice: ");
        invoice.setTotalInvoice(scanner.nextDouble());

        System.out.println("Old price: " + invoice.getTotalInvoice());
        System.out.println("New price: " + invoice.calculateDiscountPrice());

    }
}
